#!/usr/bin/env python3
"""eegact-headmap: tiny live head map (180x180 px) of EPOC X electrode connection and signal quality.

Reads epoc-record-style CSV on stdin (header row, then timestamp_ns, timestamp_iso, 14 channels, 14 *_q columns)
and draws a schematic EEG head (top view, nose up) with one indicator per electrode:
  * thick outer ring = CONNECTION quality, decided live from the last ~0.5 s of raw signal
      grey = no data, red = bad (flat / saturated / missing), orange = noisy (big jumps), green = ok
  * inner dot = SIGNAL quality over the last 2 s ("does it look like EEG"), 0..1:
      area of the dot ~ quality, colour red -> orange -> green; a perfect electrode is a fully green circle.
The estimators live in class QualityEstimator; replace it (e.g. by a small neural network) with
--estimator module:Class (same two methods).

  some-producer | ./eegact-headmap            # normally started by eegact-record
  ./eegact-headmap --lsl                       # read the EPOCX Lab Streaming Layer stream directly
  ./eegact-headmap --demo                     # random mock qualities, no input
  ./eegact-headmap --png out.png --scale 3    # render one mock frame to PNG (needs Pillow, no display)
  ./eegact-headmap --lsl --send-to=https://HOST/PATH/mental-state-logger/ --device=epocx1 [--key=SECRET]
                                               # also POST every frame as PNG to mental-state-logger

--lsl reads the 'EPOCX' stream published by `epoc-direct-record --lsl` (needs
pylsl). That stream carries raw ADC counts; they are scaled to epoc-record's
microvolt convention (LSL_ADC_TO_UV) so the same QualityEstimator applies.
With several headsets, each recorder publishes its own stream (--lsl-name, e.g.
the Bluetooth name) and each head map picks one with --lsl-name:

  ./eegact-headmap --lsl --lsl-name 'EPOCX (E5021270)' --geometry +0+0

A Muse headband (stream of `muse-record --lsl`) is shown with --layout muse
(its 4 electrodes TP9 AF7 AF8 TP10, already in uV, plus REF = its DRL/REF
reference electrodes at the centre of the forehead, which only get a contact
ring; orientation from the accelerometer only, so no yaw). Its contact rings
come from MuseQualityEstimator; --layout defaults to muse for --device muse*:

  ./eegact-headmap --lsl --lsl-name Muse --device muse1 --send-to=...

While there is no data (device not connected yet / gone), the map is drawn grey
with a red NO SIGNAL across it -- and still sent, so the server shows it dead.

The device name is printed small at the bottom, and the head orientation (from
the motion channels MOT0..MOT5, see orientation()) is shown as three bars in the
middle: yaw, pitch, roll. Click the window to zero the orientation (the current
pose becomes the reference). The small "float" toggle in the top right corner
(or the f key) keeps the window floating above other windows, or not; it starts
as --float-above says. The toggle is drawn only in the window, not in the
frames sent with --send-to.
"""
import argparse
import importlib
import math
import random
import sys
import threading
import time
from collections import deque

CHANNELS = ["AF3", "F7", "F3", "FC5", "T7", "P7", "O1", "O2", "P8", "T8", "FC6", "F4", "F8", "AF4"]
# epoc-direct-record's LSL stream is raw 16-bit ADC counts (~32768 midscale).
# epoc-record's CSV (what the QualityEstimator is tuned for) is microvolts at
# the standard EPOC-X resolution 0.1275 uV/count (32768*0.1275 ~ 4178, matching
# epoc-record's ~4200 DC offset), so scale LSL samples by this to reuse it.
LSL_ADC_TO_UV = 0.1275
SIZE = 180
# Approximate 10-20 positions of the EPOC X electrodes, unit head radius, x to the right, y to the nose.
# Slightly spread out (T7/T8 a bit down, AF3/AF4 a bit apart) so that the big indicators do not overlap.
_LEFT = {"AF3": (-0.25, 0.86), "F7": (-0.82, 0.55), "F3": (-0.40, 0.42), "FC5": (-0.72, 0.12),
         "T7": (-0.98, -0.25), "P7": (-0.72, -0.62), "O1": (-0.28, -0.90)}
_MIRROR = {"AF4": "AF3", "F8": "F7", "F4": "F3", "FC6": "FC5", "T8": "T7", "P8": "P7", "O2": "O1"}
POS = dict(_LEFT, **{r: (-_LEFT[l][0], _LEFT[l][1]) for r, l in _MIRROR.items()})

# Head orientation from the EPOC-X motion block (epoc-direct-record's MOT0..MOT6).
# MOT0..2 has a constant norm of ~16384 (1 g) -> gravity vector; MOT3..5 is taken
# to be the magnetometer (needed for yaw; gravity alone cannot give it). Both axis
# assignments are provisional -- swap/flip here after a tilt/turn test.
GRAV_CH = ("MOT0", "MOT1", "MOT2")
MAG_CH = ("MOT3", "MOT4", "MOT5")
MOTION_CHANNELS = [f"MOT{i}" for i in range(7)]  # channels whose latest value is kept (Buffers.motion())
EXTRA_CONTACTS = []  # contact-only indicators (no EEG signal) drawn besides CHANNELS, e.g. Muse's REF
ORIENT_RANGE = {"Y": 180.0, "P": 90.0, "R": 180.0}  # full-scale of each bar, degrees

# Per-device layouts; use_layout() switches the module globals above (before anything is set up).
# Muse: its 4 electrodes (as in mental-state-logger/make-mock-images.py) and REF, the DRL/REF
# reference electrodes in the centre of the forehead (judged from muse-record's drl/ref values,
# kept as latest values); samples already in uV; accelerometer ax/ay/az (g) as the gravity
# vector (axis assignment provisional, as for the EPOC), no magnetometer -> no yaw.
LAYOUTS = {
    "epocx": dict(channels=list(CHANNELS), extra=[], pos=dict(POS), lsl_scale=LSL_ADC_TO_UV,
                  grav=GRAV_CH, mag=MAG_CH, motion=list(MOTION_CHANNELS), estimator="QualityEstimator"),
    "muse": dict(channels=["TP9", "AF7", "AF8", "TP10"], extra=["REF"],
                 pos={"TP9": (-0.92, -0.45), "AF7": (-0.55, 0.72), "AF8": (0.55, 0.72), "TP10": (0.92, -0.45),
                      "REF": (0.0, 0.90)},
                 lsl_scale=1.0, grav=("ax", "ay", "az"), mag=(), motion=["ax", "ay", "az", "drl", "ref"],
                 estimator="MuseQualityEstimator"),
}
LAYOUT = "epocx"


def use_layout(name):
    global POS, LSL_ADC_TO_UV, GRAV_CH, MAG_CH, LAYOUT
    lay = LAYOUTS[name]
    CHANNELS[:] = lay["channels"]
    EXTRA_CONTACTS[:] = lay["extra"]
    MOTION_CHANNELS[:] = lay["motion"]
    POS, LSL_ADC_TO_UV, GRAV_CH, MAG_CH = lay["pos"], lay["lsl_scale"], lay["grav"], lay["mag"]
    LAYOUT = name


def orientation(mot):
    """{MOTn: value} -> (yaw, pitch, roll) in degrees, or None without motion data."""
    try:
        gx, gy, gz = (mot[c] for c in GRAV_CH)
    except KeyError:
        return None
    if not gx and not gy and not gz:
        return None
    roll = math.atan2(gy, gz)
    pitch = math.atan2(-gx, math.hypot(gy, gz))
    yaw = 0.0
    if MAG_CH and all(c in mot for c in MAG_CH):  # tilt-compensated compass heading
        mx, my, mz = (mot[c] for c in MAG_CH)
        xh = mx * math.cos(pitch) + (my * math.sin(roll) + mz * math.cos(roll)) * math.sin(pitch)
        yh = my * math.cos(roll) - mz * math.sin(roll)
        yaw = math.atan2(-yh, xh)
    return tuple(math.degrees(a) for a in (yaw, pitch, roll))


def _wrap(a):
    return (a + 180.0) % 360.0 - 180.0


GREY, RED, ORANGE, GREEN = "#9e9e9e", "#e53935", "#fb8c00", "#43a047"
CONN_COLOURS = [GREY, RED, ORANGE, GREEN]  # connection level 0..3


def mix(c1, c2, t):
    a = [int(c1[i:i + 2], 16) for i in (1, 3, 5)]
    b = [int(c2[i:i + 2], 16) for i in (1, 3, 5)]
    return "#" + "".join(f"{round(x + (y - x) * t):02x}" for x, y in zip(a, b))


def quality_colour(q):
    return mix(RED, ORANGE, q / 0.5) if q < 0.5 else mix(ORANGE, GREEN, (q - 0.5) / 0.5)


class QualityEstimator:
    """Hand-written rules; values are in the units of epoc-record (µV, DC offset around 4200)."""
    CONN_WINDOW_S = 1.5
    SIGNAL_WINDOW_S = 2.0
    # Contact is judged by how each electrode tracks the whole-head common mode
    # (the shared drift/reference every seated-on-head electrode carries) plus its
    # Hjorth mobility (fs-free ~ mean frequency: floating electrodes are broadband
    # and jittery). Both are scale-free, so a floating electrode is caught even
    # when it is quiet (std ~7 uV) -- which is exactly where the old amplitude
    # rules failed and reported a bare headset as "OK". Thresholds and smoothing
    # were calibrated on a labelled on-head/off-head recording (see FINDINGS).
    CORR_OK = 0.40      # per-1.5s-window corr-to-common-mode for a "good" vote
    MOB_OK = 0.79       # Hjorth mobility below this for a "good" vote
    FLAT_UV = 0.5       # peak-to-peak below this -> flat / shorted (always red)
    SMOOTH = 0.12       # EMA factor per call (~200 ms tick) -> ~3 s smoothing
    ONHEAD_VOTE = 0.30  # smoothed global good-vote fraction above this = on head
    GREEN_VOTE = 0.40   # smoothed per-electrode good-vote fraction for green
    ORANGE_VOTE = 0.10  # ... orange above this, red below (only truly-dead = red
                        # on head; off-head electrodes are forced red by the gate)

    def __init__(self):
        # smoothed good-vote fractions: on-head ~0.67 global / 0.2-0.8 per
        # electrode, off-head ~0.02 / <=0.37 -- so the gates below separate even
        # though any single 1.5 s window is noisy. Start at 0 (assume off head).
        self._ema_global = 0.0
        self._ema = {ch: 0.0 for ch in CHANNELS}

    def connection(self, x, q):
        """Back-compat single-channel path (grey/red/orange/green) used only if a
        custom estimator lacks ``connections``. Cannot see the common mode, so it
        falls back to amplitude heuristics. Prefer ``connections`` (whole head)."""
        vals = [v for v in x if v is not None]
        if len(vals) < max(3, len(x) // 2):
            return 0
        lo, hi = min(vals), max(vals)
        mean = sum(vals) / len(vals)
        jumps = max((abs(b - a) for a, b in zip(vals, vals[1:])), default=0.0)
        if hi - lo < 0.5 or mean < 1000 or mean > 7500:  # flat line or electrode railed / disconnected
            level = 1
        elif hi - lo > 600 or jumps > 250:                 # big jumps: loose contact, movement
            level = 2
        else:
            level = 3
        return min(level, q) if q is not None else level  # EmotivPRO's own contact quality as a cap

    def connections(self, xs, q=None):
        """Per-electrode connection level for all 14 channels at once (stateful).

        Each call votes per electrode (corr-to-common-mode high AND mobility low =
        "good"), smooths the votes over time (EMA), and uses the smoothed GLOBAL
        good-vote fraction as an on-head gate: below it, the device is off the
        head and every electrode is red -- even a quiet floating one. On the head,
        each electrode's own smoothed vote grades it green/orange/red, so a single
        lifted electrode still shows while the rest stay good.

        xs: {ch: samples of the last CONN_WINDOW_S (None = missing)}.
        q: optional {ch: EmotivPRO contact quality 0-3} cap (None in LSL mode).
        Returns {ch: 0 grey / 1 red / 2 orange / 3 green}.
        """
        import numpy as np
        n = min((sum(v is not None for v in xs.get(ch, [])) for ch in CHANNELS), default=0)
        if n < 128:  # not enough data yet to judge contact -> grey, hold EMAs
            return {ch: 0 for ch in CHANNELS}
        M = np.array([[v for v in xs[ch] if v is not None][-n:] for ch in CHANNELS], float)
        M = M - M.mean(1, keepdims=True)
        sd = M.std(1)
        cm = M.mean(0)
        cor = np.nan_to_num([np.corrcoef(M[i], cm)[0, 1] if sd[i] > 1e-6 else 0.0
                             for i in range(len(CHANNELS))])
        mob = np.array([np.std(np.diff(M[i])) / (sd[i] + 1e-9) for i in range(len(CHANNELS))])
        p2p = M.max(1) - M.min(1)
        good = (cor >= self.CORR_OK) & (mob <= self.MOB_OK)
        # smooth the per-electrode and global good-vote fractions over time
        for i, ch in enumerate(CHANNELS):
            self._ema[ch] += self.SMOOTH * (float(good[i]) - self._ema[ch])
        g_vote = float((np.median(cor) >= self.CORR_OK) and (np.median(mob) <= self.MOB_OK))
        self._ema_global += self.SMOOTH * (g_vote - self._ema_global)
        onhead = self._ema_global >= self.ONHEAD_VOTE
        out = {}
        for i, ch in enumerate(CHANNELS):
            if p2p[i] < self.FLAT_UV or not onhead:  # flat/shorted, or device off head
                lvl = 1
            elif self._ema[ch] >= self.GREEN_VOTE:
                lvl = 3
            elif self._ema[ch] >= self.ORANGE_VOTE:
                lvl = 2
            else:                                    # this electrode is off/floating
                lvl = 1
            if q and q.get(ch) is not None:
                lvl = min(lvl, q[ch])
            out[ch] = lvl
        return out

    def signal(self, x, fs):
        """x: samples of the last SIGNAL_WINDOW_S (None = missing), fs: sampling rate. Returns 0..1."""
        import numpy as np
        vals = np.array([v for v in x if v is not None], dtype=float)
        if len(vals) < 0.5 * len(x) or len(vals) < 32:
            return 0.0
        present = len(vals) / len(x)
        v = vals - np.linspace(vals[:8].mean(), vals[-8:].mean(), len(vals))  # remove offset and slow drift
        sd = v.std()
        if sd < 0.5:
            return 0.0
        # amplitude: resting EEG is a few to a few tens of µV
        amp = 1.0 if 2 <= sd <= 60 else max(0.0, 1 - abs(math.log(sd / (2 if sd < 2 else 60))) / 1.5)
        # artifacts: share of samples far from the median (blinks, movement, pops)
        art = float(np.mean(np.abs(v - np.median(v)) > max(100.0, 6 * sd)))
        # spectrum: EEG power is mostly 1-30 Hz; penalise line noise (50 Hz) and broadband/high-frequency noise
        p = np.abs(np.fft.rfft(v * np.hanning(len(v)))) ** 2
        f = np.fft.rfftfreq(len(v), 1 / fs)
        tot = p[f >= 1].sum() + 1e-9
        eeg = p[(f >= 1) & (f <= 30)].sum() / tot
        line = p[(f >= 48) & (f <= 52)].sum() / tot
        spec = min(1.0, eeg / 0.8) * (1 - min(1.0, line / 0.5))
        return float(max(0.0, min(1.0, present * amp * (1 - min(1.0, art * 5)) * spec)))


class MuseQualityEstimator(QualityEstimator):
    """Contact rings of a Muse; signal() (the inner dot) is QualityEstimator's, as for the EPOC X.

    The EPOC X rule (correlation with the common mode) does not carry over: a Muse electrode in the
    air picks up the same mains hum as its neighbours, so it correlates well with them. What separates
    contact from no contact on a Muse is plain noise, measured per electrode in the last
    CONN_WINDOW_S, smoothed over ~3 s (log-domain EMA, as QualityEstimator.SMOOTH):
      * mains hum (45-65 Hz rms) and high-frequency noise (65-128 Hz rms): off the head
        ~500-1100 and ~200-600 uV, worn with good contact ~5-15 and ~3-8 uV;
      * railing: off the head the ADC sits at both ends of its +-1000 uV range;
      * slow activity (1-30 Hz rms) far above EEG: movement / a loose electrode.
    REF, the DRL/REF electrodes in the centre of the forehead, rails at about +970 / -950 off the
    head and reads within some tens of uV when it touches the skin. Without REF contact, no EEG
    electrode can be in contact either, so they are all red then (as Muse's own horseshoe does).
    Thresholds from a Muse 2 recorded off the head and worn (2026-10-14, see the commit message).
    """
    FS = 256.0                       # Muse EEG rate
    RAIL_P2P = 1500.0                # peak-to-peak (uV) above this = railed
    LINE_OK, LINE_BAD = 20.0, 70.0   # mains 45-65 Hz rms (uV): green below OK, red above BAD
    HF_OK, HF_BAD = 10.0, 35.0       # 65-128 Hz rms (uV)
    SLOW_OK = 45.0                   # 1-30 Hz rms (uV) above this -> at most orange
    REF_OK = 300.0                   # |drl| and |ref| below this = forehead contact

    def __init__(self):
        super().__init__()
        self._feat = {}  # ch -> smoothed log features

    def forehead(self, latest):
        """Contact level of REF from the latest drl/ref values (0 = no data)."""
        if not latest or "drl" not in latest or "ref" not in latest:
            return 0
        return 3 if abs(latest["drl"]) < self.REF_OK and abs(latest["ref"]) < self.REF_OK else 1

    def connections(self, xs, q=None, latest=None):
        import numpy as np
        ref = self.forehead(latest)
        out = {ch: 0 for ch in CHANNELS}
        out.update({c: ref for c in EXTRA_CONTACTS})
        n = min((sum(v is not None for v in xs.get(ch, [])) for ch in CHANNELS), default=0)
        if n < 128:  # not enough data yet -> grey
            return out
        w = np.hanning(n)
        f = np.fft.rfftfreq(n, 1 / self.FS)
        bands = {"slow": (f >= 1) & (f < 30), "line": (f >= 45) & (f < 65), "hf": f >= 65}
        for ch in CHANNELS:
            x = np.array([v for v in xs[ch] if v is not None][-n:], float)
            p2p = x.max() - x.min()
            if p2p < self.FLAT_UV or p2p > self.RAIL_P2P or ref == 1:  # flat / railed / no reference
                self._feat.pop(ch, None)
                out[ch] = 1
                continue
            P = np.abs(np.fft.rfft((x - x.mean()) * w)) ** 2 * 2 / (n * (w ** 2).sum())  # one-sided mean-square
            feat = {k: math.log(math.sqrt(P[m].sum()) + 1e-3) for k, m in bands.items()}
            old = self._feat.get(ch)
            if old is not None:
                feat = {k: old[k] + self.SMOOTH * (v - old[k]) for k, v in feat.items()}
            self._feat[ch] = feat
            line, hf, slow = (math.exp(feat[k]) for k in ("line", "hf", "slow"))
            if line > self.LINE_BAD or hf > self.HF_BAD:
                out[ch] = 1
            elif line > self.LINE_OK or hf > self.HF_OK or slow > self.SLOW_OK:
                out[ch] = 2
            else:
                out[ch] = 3
        return out


# ---------------------------------------------------------------- drawing (tk canvas or PIL, same code)
def draw(p, conn, sig, scale=1.0, labels=True, name=None, ypr=None, dead=False):
    """p: painter with oval/line/polygon/text; conn: {ch: 0..3}; sig: {ch: 0..1 or None};
    name: device name printed at the bottom; ypr: (yaw, pitch, roll) degrees for the middle bars;
    dead: no data from the device -> red NO SIGNAL across the head."""
    s = scale
    cx, cy, R = 90 * s, 95 * s, 66 * s
    er, ring = 13 * s, 4 * s  # electrode indicator radius and ring width
    p.polygon([(cx - 9 * s, cy - R + 2 * s), (cx, cy - R - 12 * s), (cx + 9 * s, cy - R + 2 * s)],
              fill="#f5f5f5", outline="#555555", width=max(1, round(1.5 * s)))          # nose
    for side in (-1, 1):                                                                  # ears
        x = cx + side * R
        p.oval(x - 7 * s, cy - 15 * s, x + 7 * s, cy + 15 * s, fill="#f5f5f5", outline="#555555",
               width=max(1, round(1.5 * s)))
    p.oval(cx - R, cy - R, cx + R, cy + R, fill="#f5f5f5", outline="#555555", width=max(1, round(1.5 * s)))
    for ch in CHANNELS + EXTRA_CONTACTS:
        ux, uy = POS[ch]
        x, y = cx + ux * R * 0.93, cy - uy * R * 0.93
        c = conn.get(ch, 0)
        p.oval(x - er, y - er, x + er, y + er, fill="#ffffff", outline=CONN_COLOURS[c], width=round(ring))
        q = sig.get(ch)
        if q:
            r = (er - ring) * math.sqrt(q) + 0.5 * s  # area ~ quality; q = 1 fills the ring completely
            p.oval(x - r, y - r, x + r, y + r, fill=quality_colour(q), outline="", width=0)
        if labels:
            p.text(x, y, ch, size=max(5, round(6 * s)))
    if ypr is not None:  # three signed bars in the free middle of the head: yaw, pitch, roll
        bx, hw, bh = cx + 4 * s, 22 * s, 6 * s  # bar centre (zero), half width, height
        for i, (lab, a) in enumerate(zip("YPR", ypr)):
            y = cy - 6 * s + i * 11 * s
            p.polygon([(bx - hw, y - bh / 2), (bx + hw, y - bh / 2), (bx + hw, y + bh / 2), (bx - hw, y + bh / 2)],
                      fill="#ffffff", outline="#9e9e9e", width=1)
            v = max(-1.0, min(1.0, a / ORIENT_RANGE[lab]))
            if abs(v * hw) >= 0.5:
                p.polygon([(bx, y - bh / 2), (bx + v * hw, y - bh / 2), (bx + v * hw, y + bh / 2), (bx, y + bh / 2)],
                          fill="#1e88e5", outline="", width=0)
            p.polygon([(bx, y - bh / 2 - s), (bx, y + bh / 2 + s)], fill="", outline="#555555", width=1)
            p.text(bx - hw - 5 * s, y, lab, size=max(5, round(7 * s)))
    if dead:
        p.text(cx, cy, "NO SIGNAL", size=max(8, round(16 * s)), fill=RED)
    if name:
        p.text(cx, SIZE * s - 6 * s, name, size=max(6, round(8 * s)), bold=False)


class TkPainter:
    def __init__(self, canvas):
        self.c = canvas

    def oval(self, x0, y0, x1, y1, fill, outline, width):
        self.c.create_oval(x0, y0, x1, y1, fill=fill, outline=outline, width=width)

    def polygon(self, pts, fill, outline, width):
        if len(pts) == 2:  # a line
            self.c.create_line([v for pt in pts for v in pt], fill=outline, width=width)
        else:
            self.c.create_polygon([v for pt in pts for v in pt], fill=fill, outline=outline, width=width)

    def text(self, x, y, t, size, bold=True, fill="#212121"):
        self.c.create_text(x, y, text=t, fill=fill, font=("Helvetica", -size, "bold" if bold else "normal"))


class PilPainter:
    def __init__(self, img):
        from PIL import ImageDraw
        self.d = ImageDraw.Draw(img)

    def oval(self, x0, y0, x1, y1, fill, outline, width):
        self.d.ellipse([x0, y0, x1, y1], fill=fill, outline=outline or None, width=width)

    def polygon(self, pts, fill, outline, width):
        if len(pts) == 2:  # a line
            self.d.line(pts, fill=outline, width=width)
        else:
            self.d.polygon(pts, fill=fill or None, outline=outline or None, width=width)

    def text(self, x, y, t, size, bold=True, fill="#212121"):
        from PIL import ImageFont
        try:
            font = ImageFont.truetype("DejaVuSans-Bold.ttf" if bold else "DejaVuSans.ttf", size)
        except OSError:
            font = ImageFont.load_default()
        self.d.text((x, y), t, fill=fill, font=font, anchor="mm")


class Sender:
    """Ships the latest frame as PNG to mental-state-logger's feed-status-image.php in a background thread.

    URL may be the mental-state-logger directory or the full feed-status-image.php URL. Only the newest
    frame is kept (slow network = dropped frames, never a growing queue); an unchanged frame is re-sent
    at most every HEARTBEAT_S seconds. Errors are reported on stderr (once per change) and never stop the GUI.
    """
    HEARTBEAT_S = 2.0

    def __init__(self, url, device, key=None):
        from urllib.parse import quote
        if "feed-status-image.php" not in url:
            url = url.rstrip("/") + "/feed-status-image.php"
        sep = "&" if "?" in url else "?"
        self.url = f"{url}{sep}device={quote(device)}" + (f"&key={quote(key)}" if key else "")
        self.cv = threading.Condition()
        self.png = None
        self.last = (None, 0.0)
        self.err = None
        threading.Thread(target=self._run, daemon=True).start()

    def submit(self, img):
        import io
        b = io.BytesIO()
        img.save(b, "PNG")
        with self.cv:
            self.png = b.getvalue()
            self.cv.notify()

    def _run(self):
        import urllib.request
        while True:
            with self.cv:
                while self.png is None:
                    self.cv.wait()
                png, self.png = self.png, None
            if png == self.last[0] and time.time() - self.last[1] < self.HEARTBEAT_S:
                continue
            try:
                req = urllib.request.Request(self.url, data=png, headers={"Content-Type": "image/png"})
                urllib.request.urlopen(req, timeout=5).close()
                self.last = (png, time.time())
                if self.err:
                    print("# send-to: OK again", file=sys.stderr, flush=True)
                self.err = None
            except Exception as e:
                if str(e) != self.err:
                    print(f"# send-to failed: {e}", file=sys.stderr, flush=True)
                self.err = str(e)
                time.sleep(1.0)


def mock():
    conn, sig = {c: 3 for c in EXTRA_CONTACTS}, {}
    for ch in CHANNELS:
        conn[ch] = random.choices([0, 1, 2, 3], [1, 1, 2, 8])[0]
        sig[ch] = None if conn[ch] == 0 else round(random.random() ** 0.5 * (conn[ch] / 3), 2)
    conn[CHANNELS[0]], sig[CHANNELS[0]] = 3, 1.0  # one perfect electrode
    return conn, sig


def mock_ypr():
    return random.uniform(-120, 120), random.uniform(-45, 45), random.uniform(-60, 60)


# ---------------------------------------------------------------- live input
class Buffers:
    def __init__(self, seconds=4.0):
        self.lock = threading.Lock()
        self.seconds = seconds
        self.t = deque()
        self.x = {ch: deque() for ch in CHANNELS}
        self.q = {ch: None for ch in CHANNELS}
        self.idx = None
        self.last_rx = 0.0
        self.mot = {}            # latest motion values {MOTn: value} (arrive ~32 Hz, not every row)
        self.device_name = None  # from the LSL stream (desc/device_name, else its name)

    def read(self, stream):
        for line in stream:
            f = line.rstrip("\n").split(",")
            if self.idx is None or f[0] == "timestamp_ns":
                if f[0] == "timestamp_ns":
                    self.idx = {name: i for i, name in enumerate(f)}
                    continue
                self.idx = {name: i for i, name in enumerate(["timestamp_ns", "timestamp_iso"] + CHANNELS +
                                                             [c + "_q" for c in CHANNELS])}
            try:
                t = int(f[0]) / 1e9
            except (ValueError, IndexError):
                continue
            with self.lock:
                self.t.append(t)
                for ch in CHANNELS:
                    self.x[ch].append(_num(f, self.idx.get(ch)))
                    qv = _num(f, self.idx.get(ch + "_q"))
                    if qv is not None:
                        self.q[ch] = int(qv)
                for m in MOTION_CHANNELS:
                    mv = _num(f, self.idx.get(m))
                    if mv is not None:
                        self.mot[m] = mv
                while self.t and self.t[0] < t - self.seconds:
                    self.t.popleft()
                    for ch in CHANNELS:
                        self.x[ch].popleft()
                self.last_rx = time.time()

    def read_lsl(self, name="EPOCX", scale=None):
        """Fill the same buffers from the 'EPOCX' Lab Streaming Layer stream.

        Resolves the stream by name, maps its channel labels to our 14
        electrodes, and appends each sample (scaled ADC->uV). Contact-quality
        hints stay None (the raw stream carries no per-electrode quality), so
        the estimator works purely from the signal. Samples without any EEG
        value (e.g. muse-record's acc/gyro/ppg rows) only update the motion.
        """
        scale = LSL_ADC_TO_UV if scale is None else scale
        from pylsl import StreamInlet, resolve_byprop
        print(f"# resolving LSL stream '{name}' ...", file=sys.stderr, flush=True)
        while not (streams := resolve_byprop("name", name, timeout=5.0)):  # recorder may still be connecting
            print(f"# no LSL stream '{name}' found yet (is `epoc-direct-record --lsl` running?); retrying",
                  file=sys.stderr, flush=True)
        inlet = StreamInlet(streams[0], recover=True)
        info = inlet.info()
        labels, ch = [], info.desc().child("channels").child("channel")
        while not ch.empty():
            labels.append(ch.child_value("label"))
            ch = ch.next_sibling()
        idx = {lab: i for i, lab in enumerate(labels)}
        chan_idx = {c: idx.get(c) for c in CHANNELS}
        if all(i is None for i in chan_idx.values()):  # no labels -> assume our order
            chan_idx = {c: 2 + i for i, c in enumerate(CHANNELS)}  # after packet_size,frame_counter
        mot_idx = {m: idx[m] for m in MOTION_CHANNELS if m in idx}
        self.device_name = info.desc().child_value("device_name") or info.name()
        print(f"# connected to '{info.name()}' ({info.channel_count()} ch), device {self.device_name}",
              file=sys.stderr, flush=True)
        while True:
            sample, ts = inlet.pull_sample(timeout=1.0)
            if sample is None:
                continue
            t = ts if ts and ts > 1e9 else time.time()
            vals = {}
            for c in CHANNELS:
                i = chan_idx.get(c)
                v = sample[i] if (i is not None and i < len(sample)) else None
                vals[c] = None if v is None or v != v else v * scale  # missing or NaN -> None
            with self.lock:
                for m, i in mot_idx.items():
                    if i < len(sample) and sample[i] == sample[i]:  # NaN on rows without motion
                        self.mot[m] = sample[i]
                self.last_rx = time.time()
                if all(v is None for v in vals.values()):  # not an EEG row
                    continue
                self.t.append(t)
                for c in CHANNELS:
                    self.x[c].append(vals[c])
                while self.t and self.t[0] < t - self.seconds:
                    self.t.popleft()
                    for c in CHANNELS:
                        self.x[c].popleft()
                self.last_rx = time.time()

    def window(self, seconds):
        """Samples of the last `seconds` per channel, sampling rate, last contact quality."""
        with self.lock:
            if not self.t or time.time() - self.last_rx > 1.5:  # stream stalled
                return None, 0.0, {}
            n = sum(1 for t in self.t if t >= self.t[-1] - seconds)
            span = self.t[-1] - self.t[0]
            fs = (len(self.t) - 1) / span if span > 0 else 128.0
            return {ch: list(self.x[ch])[-n:] for ch in CHANNELS}, fs, dict(self.q)

    def motion(self):
        with self.lock:
            return dict(self.mot) if time.time() - self.last_rx <= 1.5 else {}


def _num(f, i):
    try:
        return float(f[i]) if i is not None and f[i] != "" else None
    except (ValueError, IndexError):
        return None


def run_gui(args, est):
    import tkinter as tk
    root = tk.Tk()
    root.title(args.name or (args.lsl_name if getattr(args, "lsl", False) else "eegact"))
    root.geometry(f"{SIZE}x{SIZE}{args.geometry or ''}")
    root.resizable(False, False)
    canvas = tk.Canvas(root, width=SIZE, height=SIZE, bg="#ffffff", highlightthickness=0)
    canvas.pack()
    painter = TkPainter(canvas)
    floating = {"on": bool(args.float_above)}
    root.attributes("-topmost", floating["on"])
    FLOAT_BOX = (SIZE - 34, 0, SIZE, 14)  # the "float" toggle, top right corner

    def toggle_float(_ev=None):
        floating["on"] = not floating["on"]
        root.attributes("-topmost", floating["on"])
        draw_float()

    def draw_float():
        canvas.delete("float")
        x0, y0, x1, y1 = FLOAT_BOX
        on = floating["on"]
        canvas.create_rectangle(x0 + 1, y0 + 1, x1 - 2, y1 - 1, fill="#1e88e5" if on else "#ffffff",
                                outline="#1e88e5" if on else "#bdbdbd", tags="float")
        canvas.create_text((x0 + x1) / 2, (y0 + y1) / 2, text="float", tags="float",
                           fill="#ffffff" if on else "#9e9e9e", font=("Helvetica", -9, "bold" if on else "normal"))
    root.bind("<KeyPress-f>", toggle_float)
    buf = None
    if not args.demo:
        buf = Buffers()
        if getattr(args, "lsl", False):
            threading.Thread(target=buf.read_lsl, args=(args.lsl_name,), daemon=True).start()
        else:
            threading.Thread(target=buf.read, args=(sys.stdin,), daemon=True).start()
    state = {"conn": {}, "sig": {}, "last_sig": 0.0, "ypr_raw": None, "zero": (0.0, 0.0, 0.0)}
    sender = Sender(args.send_to, args.device, args.key) if args.send_to else None

    def rezero(ev=None):  # click: the current pose becomes yaw = pitch = roll = 0
        x0, y0, x1, y1 = FLOAT_BOX
        if ev is not None and x0 <= ev.x <= x1 and y0 <= ev.y <= y1:
            toggle_float()
            return
        raw = state["ypr_raw"]
        if raw:
            state["zero"] = raw
            print(f"# orientation zeroed at yaw/pitch/roll {raw[0]:.0f}/{raw[1]:.0f}/{raw[2]:.0f} deg",
                  file=sys.stderr, flush=True)
    canvas.bind("<Button-1>", rezero)

    def tick():
        now = time.time()
        if args.demo:
            state["conn"], state["sig"] = mock()
            state["ypr_raw"] = mock_ypr()
        else:
            latest = buf.motion()
            state["ypr_raw"] = orientation(latest)
            xs, fs, q = buf.window(est.CONN_WINDOW_S)
            state["dead"] = not xs
            if not xs:
                state["conn"] = {}
            elif hasattr(est, "forehead"):  # MuseQualityEstimator: also judges REF from drl/ref
                state["conn"] = est.connections(xs, q, latest=latest)
            elif hasattr(est, "connections"):
                state["conn"] = est.connections(xs, q)
            else:
                state["conn"] = {ch: est.connection(xs[ch], q.get(ch)) for ch in CHANNELS}
            if now - state["last_sig"] >= 0.5:
                state["last_sig"] = now
                xs, fs, _ = buf.window(est.SIGNAL_WINDOW_S)
                state["sig"] = {ch: est.signal(xs[ch], fs) for ch in CHANNELS} if xs else {}
        raw = state["ypr_raw"]
        ypr = tuple(_wrap(a - z) for a, z in zip(raw, state["zero"])) if raw else None
        name = args.name or (buf.device_name if buf else "demo") or args.lsl_name
        dead = state.get("dead", False)
        canvas.delete("all")
        ypr = None if args.no_orientation else ypr
        draw(painter, state["conn"], state["sig"], labels=not args.no_labels, name=name, ypr=ypr, dead=dead)
        draw_float()
        if sender:
            from PIL import Image
            img = Image.new("RGB", (SIZE, SIZE), "#ffffff")
            draw(PilPainter(img), state["conn"], state["sig"], labels=not args.no_labels, name=name, ypr=ypr,
                 dead=dead)
            sender.submit(img)
        root.after(1000 if args.demo else 200, tick)

    tick()
    try:
        root.mainloop()
    except KeyboardInterrupt:
        pass


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("--demo", action="store_true", help="random mock qualities instead of stdin")
    ap.add_argument("--lsl", action="store_true",
                    help="read the EPOCX Lab Streaming Layer stream instead of stdin CSV (needs pylsl)")
    ap.add_argument("--lsl-name", default="EPOCX", help="LSL stream name to resolve (default EPOCX)")
    ap.add_argument("--png", help="render one mock frame to this PNG and exit (Pillow)")
    ap.add_argument("--scale", type=float, default=1.0, help="scale of the --png rendering (1 = 180x180)")
    ap.add_argument("--seed", type=int, default=4)
    ap.add_argument("--no-labels", action="store_true", help="do not print electrode names")
    ap.add_argument("--float-above", action="store_true",
                    help="start with the window floating above other windows (default: a normal window); "
                    "toggle at runtime with the 'float' corner button or the f key")
    ap.add_argument("--geometry", help="window position, Tk style, e.g. +0+0 or -0+200")
    ap.add_argument("--name", help="device name shown at the bottom and as window title "
                    "(default: from the LSL stream)")
    ap.add_argument("--no-orientation", action="store_true", help="do not draw the yaw/pitch/roll bars")
    ap.add_argument("--send-to", metavar="URL",
                    help="also POST each frame as PNG to mental-state-logger (its URL or feed-status-image.php URL)")
    ap.add_argument("--device", default="epocx1",
                    help="device id reported with --send-to: epocx1, epocx2, muse1 (default epocx1)")
    ap.add_argument("--layout", choices=sorted(LAYOUTS),
                    help="electrode layout (default: muse for --device muse*, else epocx)")
    ap.add_argument("--dead", action="store_true", help="with --png: draw the NO SIGNAL frame")
    ap.add_argument("--key", help="shared secret for --send-to (if the server has data/feed-key.txt)")
    ap.add_argument("--estimator", help="module:Class replacing QualityEstimator")
    a = ap.parse_args()
    random.seed(a.seed)
    use_layout(a.layout or ("muse" if a.device.startswith("muse") else "epocx"))
    if a.png:
        from PIL import Image
        img = Image.new("RGB", (round(SIZE * a.scale),) * 2, "#ffffff")
        conn, sig = ({}, {}) if a.dead else mock()
        draw(PilPainter(img), conn, sig, scale=a.scale, labels=not a.no_labels,
             name=a.name or "EPOCX (E5021270)", ypr=None if a.no_orientation or a.dead else mock_ypr(),
             dead=a.dead)
        img.save(a.png)
        return
    est = globals()[LAYOUTS[LAYOUT]["estimator"]]()
    if a.estimator:
        mod, cls = a.estimator.split(":")
        est = getattr(importlib.import_module(mod), cls)()
    run_gui(a, est)


if __name__ == "__main__":
    main()
